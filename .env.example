# Use a URL-safe random password, for example: openssl rand -hex 24
POSTGRES_PASSWORD=replace_with_random_hex_password
MQTT_URL=tcp://192.168.1.10:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Keep this aligned with the collector firmware (eir/v1).
MQTT_PREFIX=eir/v1
# Must be reachable from ESP32; do not use localhost here.
EIR_PUBLIC_URL=http://192.168.1.10:8080
EIR_BIND_ADDRESS=0.0.0.0
EIR_PORT=8080
EIR_IMAGE=eir:local
TZ=Asia/Shanghai

# Optional Web Push; generate keys once with eir push-keygen and keep private.
EIR_PUSH_ENABLED=false
EIR_PUSH_VAPID_PUBLIC_KEY=
EIR_PUSH_VAPID_PRIVATE_KEY=
EIR_PUSH_VAPID_SUBJECT=
