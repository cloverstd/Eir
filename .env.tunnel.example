# Copy to .env.tunnel. The tunnel must be associated with the intended ChatGPT workspace.
EIR_TUNNEL_ID=tunnel_replace_with_your_tunnel_id
# Put only the runtime API key in this private file; never put it in this env file.
EIR_TUNNEL_API_KEY_FILE=./.local/chatgpt-tunnel.key
# Pin a reviewed official release or digest. No automatic upgrades.
EIR_TUNNEL_IMAGE=ghcr.io/openai/tunnel-client:v0.0.16
